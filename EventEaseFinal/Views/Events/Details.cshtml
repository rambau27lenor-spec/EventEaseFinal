@model EventEaseFinal.Models.Event

<h1>Event Details</h1>

<p><strong>Name:</strong> @Model.EventName</p>
<p><strong>Date:</strong> @Model.EventDate.ToShortDateString()</p>
<p><strong>Type:</strong> @Model.EventType?.Name</p>
<p><strong>Description:</strong> @Model.Description</p>

<a asp-action="Edit" asp-route-id="@Model.EventId">Edit</a> |
<a asp-action="Index">Back to List</a>
