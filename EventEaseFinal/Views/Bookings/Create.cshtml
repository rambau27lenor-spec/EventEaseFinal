@model EventEaseFinal.Models.Booking

<h1>Create Booking</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create">
    <label asp-for="EventId">Event</label>
    <select asp-for="EventId" class="form-control" asp-items="ViewBag.EventId">
        <option value="">Select Event</option>
    </select>

    <label asp-for="VenueId">Venue</label>
    <select asp-for="VenueId" class="form-control" asp-items="ViewBag.VenueId">
        <option value="">Select Available Venue</option>
    </select>

    <label asp-for="BookingDate"></label>
    <input asp-for="BookingDate" type="date" class="form-control" />

    <br />
    <button type="submit" class="btn btn-primary">Create</button>
</form>

<a asp-action="Index">Back to List</a>